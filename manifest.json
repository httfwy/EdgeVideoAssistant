{
  "manifest_version": 3,
  "name": "Edge Video Assistant",
  "description": "网页视频检测、下载与录制助手",
  "version": "0.1.0",
  "action": {
    "default_title": "Edge Video Assistant",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "webRequest",
    "downloads",
    "notifications",
    "offscreen",
    "tabCapture",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "options_page": "src/pages/options/index.html",
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/index.ts"],
      "css": ["src/content/overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/pageHook.ts"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/content/crop-bridge.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
